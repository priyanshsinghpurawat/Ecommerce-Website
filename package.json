{
  "name": "mensvibe",
  "private": true,
  "author": "Priyansh Singh Purawat <priyanshsinghpurawatji@gmail.com>",
  "type": "module",
  "scripts": {
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "test": "npm run test --prefix client && npm run test --prefix server",
    "test:watch": "node server/scripts/test-watch.js",
    "lint": "npm run lint --prefix client && npm run lint --prefix server",
    "seed": "npm run seed --prefix server",
    "env:sample": "node -e \"const fs=require('fs'); fs.copyFileSync('server/.env.example', 'server/.env');\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8"
  },
  "lint-staged": {
    "client/**/*.{js,jsx}": [
      "npm run lint --prefix client"
    ],
    "server/**/*.js": [
      "npm run lint --prefix server"
    ]
  }
}

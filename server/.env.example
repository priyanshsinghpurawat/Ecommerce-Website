PORT=3000
NODE_ENV=development
# Comma-separated for multiple origins (local + deployed frontend)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/e-commerce
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=your_jwt_secret_key_here_must_be_at_least_32_characters_long
JWT_EXPIRY=1d

# Required for admin product image uploads (v1 — Cloudinary only)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Social Auth
GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional — online payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Self-ping keep-alive (set to your Render backend URL to prevent cold starts)
SERVER_URL=https://your-app.onrender.com

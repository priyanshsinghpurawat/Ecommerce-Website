						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"shippingAddress\": {\n        \"fullName\": \"John Doe\",\n        \"phone\": \"9876543210\",\n        \"street\": \"123 Fashion Ave\",\n        \"city\": \"Mumbai\",\n        \"state\": \"Maharashtra\",\n        \"zipCode\": \"400001\",\n        \"country\": \"India\"\n    },\n    \"paymentMethod\": \"cod\",\n    \"couponCode\": \"MENSVIBE10\"\n}",
							"options": {
